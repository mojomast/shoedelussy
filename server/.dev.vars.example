# Development environment variables for shoedelussy API
# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is gitignored and used by wrangler for local development

# Default LLM provider. Point LLM_BASE_URL at any OpenAI-compatible endpoint.
# Defaults to OpenRouter when LLM_BASE_URL is unset.
# Example (Requesty): LLM_BASE_URL=https://router.requesty.ai/v1
# LLM_BASE_URL=https://router.requesty.ai/v1

# API key for the default provider (required).
# LLM_API_KEY=rqsty-sk-...
LLM_API_KEY=your-api-key-here

# Model ID served by the default provider.
# LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Legacy OpenRouter configuration (used when LLM_* vars are unset)
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: Frontend URL used in share links and OpenRouter headers.
# Production share links should use https://strudel.ussyco.de.
# APP_URL=http://localhost:5173

# Optional: Bearer token required by /mcp in deployed environments
MCP_SECRET=local-dev-secret
